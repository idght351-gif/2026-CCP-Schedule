rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: schedules
    // Fields:
    //   - id: number (required)
    //   - teamName: string (required, max 100)
    //   - leaderName: string (required, max 50)
    //   - phone: string (required)
    //   - date: string (required, format: M/D(Day))
    //   - location: string (required)
    //   - keyword: string (required)
    //   - count: number (required)
    //   - memo: string (optional)
    //
    // Collection: changeRequests
    // Fields:
    //   - id: number (required)
    //   - our: map (required, Schedule schema)
    //   - target: map (required, Schedule schema)
    //   - status: string (required, enum: ['pending', 'approved', 'rejected'])
    //   - timestamp: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidAdminKey(key) {
      return key in ['2016041', '2016343', '2021166', '2017032'];
    }

    // For write operations, we verify the adminKey is present and valid in the payload.
    // This allows the app to work even if Anonymous Auth is disabled in the console.
    function isAuthorizedWrite(data) {
      return 'adminKey' in data && 
             isValidAdminKey(data.adminKey);
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['teamName', 'leaderName', 'date', 'location', 'keyword', 'count', 'phone']) &&
             data.teamName is string && data.teamName.size() <= 100 &&
             data.leaderName is string && data.leaderName.size() <= 100 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.date is string && data.date.size() <= 50 &&
             data.location is string && data.location.size() <= 200 &&
             data.keyword is string && data.keyword.size() <= 100 &&
             data.count is number && data.count >= 0 && data.count < 1000;
    }

    function isValidChangeRequest(data) {
      return data.keys().hasAll(['our', 'target', 'status', 'timestamp']) &&
             data.status == 'pending' &&
             data.our is map && data.target is map &&
             data.timestamp is string && data.timestamp.size() <= 100 &&
             (!('sentSmsOur' in data) || data.sentSmsOur is bool) &&
             (!('sentSmsTarget' in data) || data.sentSmsTarget is bool);
    }

    function isValidLog(data) {
      return data.keys().hasAll(['adminKey', 'action', 'timestamp']) &&
             isValidAdminKey(data.adminKey) &&
             data.action is string &&
             data.timestamp is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update: if isAuthorizedWrite(request.resource.data);
      // For delete, we rely on the client logic and the fact that 
      // sensitive actions are logged with adminKey.
      allow delete: if true; 
    }

    match /changeRequests/{requestId} {
      allow read: if true;
      allow create: if isValidChangeRequest(request.resource.data);
      allow update: if isAuthorizedWrite(request.resource.data) || 
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sentSmsOur', 'sentSmsTarget']));
      allow delete: if true;
    }

    match /logs/{logId} {
      allow read: if false; // Only admins can see logs? For now, no read.
      allow create: if isValidLog(request.resource.data);
    }
    
    match /test_connection/{docId} {
      allow read, list: if true;
    }
  }
}
