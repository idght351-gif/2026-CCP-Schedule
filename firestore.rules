rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: schedules
    // Fields:
    //   - id: number (required)
    //   - teamName: string (required, max 100)
    //   - leaderName: string (required, max 50)
    //   - phone: string (required)
    //   - date: string (required, format: M/D(Day))
    //   - location: string (required)
    //   - keyword: string (required)
    //   - count: number (required)
    //   - memo: string (optional)
    //
    // Collection: changeRequests
    // Fields:
    //   - id: number (required)
    //   - our: map (required, Schedule schema)
    //   - target: map (required, Schedule schema)
    //   - status: string (required, enum: ['pending', 'approved', 'rejected'])
    //   - timestamp: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "idght351@gmail.com" &&
             request.auth.token.email_verified == true;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['teamName', 'leaderName', 'date', 'location', 'keyword', 'count', 'phone']) &&
             data.teamName is string && data.teamName.size() <= 100 &&
             data.leaderName is string && data.leaderName.size() <= 100 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.date is string && data.date.size() <= 50 &&
             data.location is string && data.location.size() <= 200 &&
             data.keyword is string && data.keyword.size() <= 100 &&
             data.count is number && data.count >= 0 && data.count < 1000;
    }

    function isValidChangeRequest(data) {
      return data.keys().hasAll(['our', 'target', 'status', 'timestamp']) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.our is map && data.target is map &&
             data.timestamp is string && data.timestamp.size() <= 100 &&
             (!('sentSmsOur' in data) || data.sentSmsOur is bool) &&
             (!('sentSmsTarget' in data) || data.sentSmsTarget is bool);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /changeRequests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidChangeRequest(request.resource.data);
      allow update, delete: if isAdmin();
    }
    
    match /test_connection/{docId} {
      allow read, list: if true;
    }
  }
}
